datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Auth Models ───────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("USER") // USER | ADMIN
  password      String?
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  firstName String?
  lastName  String?
}

// ─── Product Models ────────────────────────────────────────────

model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String?  @unique
  status       String   @default("DRAFT") // DRAFT | ACTIVE | ARCHIVED
  price        Float
  unit         String
  collection   String
  category     String
  description  String
  details      String[]
  dimensions   String
  material     String
  finish       String
  images       String[] // Legacy field kept for compatibility
  techSpecs    Json
  installation String[]

  // SEO
  seoTitle       String?
  seoDescription String?

  // Relations
  productImages ProductImage[]
  variants      Variant[]
  options       Option[]
  orderItems    OrderItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Inquiry   Inquiry[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String  @default("")
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Option {
  id        String        @id @default(cuid())
  productId String
  name      String // e.g. "Size", "Finish", "Color"
  position  Int           @default(0)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    OptionValue[]
}

model OptionValue {
  id       String @id @default(cuid())
  optionId String
  value    String // e.g. "30x30", "Matte"
  option   Option @relation(fields: [optionId], references: [id], onDelete: Cascade)
}

model Variant {
  id        String  @id @default(cuid())
  productId String
  title     String // e.g. "30x30 / Matte"
  sku       String?
  price     Float
  options   Json // { "Dimension": "30x30", "Texture": "Matte" }
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─── Order Models ──────────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  customerEmail   String?
  customerName    String?
  customerPhone   String?
  customerAddress String?
  customerCity    String?
  customerRegion  String?
  total           Float
  status          String      @default("PENDING") // PENDING, IN_REVIEW, APPROVED, PAYMENT_PENDING, PAID, CANCELLED
  type            String      @default("ORDER_REQUEST") // ORDER_REQUEST, INQUIRY
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Payout {
  id          String   @id @default(cuid())
  amount      Float
  status      String   @default("PENDING") // PENDING, COMPLETED, FAILED
  reference   String   @unique
  bankDetails String?
  fees        Float    @default(0)
  netAmount   Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // The collection of orders that were included in this payout
  orderIds String[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  dimension String?
  texture   String?
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Inquiry {
  id            String   @id @default(cuid())
  productId     String
  dimension     String
  texture       String
  quantity      Int      @default(1)
  message       String?
  customerName  String
  customerEmail String
  customerPhone String?
  status        String   @default("PENDING") // PENDING, RESPONDED, CLOSED
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─── Payment & Finance Models ───────────────────────────────────

model WithdrawalRequest {
  id          String    @id @default(cuid())
  amount      Float
  destination String
  network     String    @default("wave")
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED
  requestedAt DateTime  @default(now())
  processedAt DateTime?
}

model Transaction {
  id                 String   @id @default(cuid())
  orderId            String?
  amount             Float
  netMerchantAmount  Float
  platformCommission Float
  status             String
  modemPayRef        String?
  createdAt          DateTime @default(now())
}
